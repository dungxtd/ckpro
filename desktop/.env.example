# PostHog project API key (phc_…) for usage analytics; unset, the app sends nothing
VITE_POSTHOG_KEY=
# Defaults to the US cloud
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Release builds: upload source maps so errors show the original code (a
# personal API key, never committed); unset, no maps are made
# POSTHOG_CLI_API_KEY=phx_…
# POSTHOG_CLI_PROJECT_ID=696626
# POSTHOG_CLI_HOST=https://us.posthog.com
