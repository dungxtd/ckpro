{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CKPro",
  "mainBinaryName": "ckpro",
  "version": "0.3.4",
  "identifier": "dev.ckpro.CKPro",
  "build": {
    "beforeDevCommand": "pnpm vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "appDirectoriesOverride": "$LOCALDATA/ckpro",
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CKPro",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:* https://us.i.posthog.com https://us-assets.i.posthog.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "worker-src": "'self' blob:"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:1420 https://us.i.posthog.com https://us-assets.i.posthog.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "worker-src": "'self' blob:"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDQjVFOTY4MzY2QTM5NUUKUldSZU9XbzJhT20xN0FrYlg2VFJ0MS9mY2FiQ2JuV2JjTWJkTFhoZTFGRmtGdEd6dWl2ZGNzalcK",
      "endpoints": [
        "https://github.com/dungxtd/ckpro/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "license": "GPL-3.0-only",
    "copyright": "© 2026 dungxtd",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../packs": "packs"
    }
  }
}
