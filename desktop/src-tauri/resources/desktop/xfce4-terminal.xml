<?xml version="1.0" encoding="UTF-8"?>
<!-- Light on dark -->
<channel name="xfce4-terminal" version="1.0">
  <property name="color-use-theme" type="bool" value="false"/>
  <property name="color-foreground" type="string" value="#dcdcdc"/>
  <property name="color-background" type="string" value="#1e1e1e"/>
  <property name="color-cursor" type="string" value="#dcdcdc"/>
  <!-- A blinking cursor redraws the screen twice a second, idle or not -->
  <property name="misc-cursor-blinks" type="bool" value="false"/>
</channel>
