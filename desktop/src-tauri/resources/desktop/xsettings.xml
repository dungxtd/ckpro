<?xml version="1.0" encoding="UTF-8"?>
<!-- The exam desktop's look (Ubuntu's Xfce), dark: Greybird-dark, elementary-xfce-dark icons -->
<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Greybird-dark"/>
    <property name="IconThemeName" type="string" value="elementary-xfce-dark"/>
    <!-- The desktop runs at the screen's native resolution (2x on HiDPI), so
         a small hand movement is twice the pixels: GTK's defaults (5 px for a
         double-click, 8 px to start a drag) turned double-clicks into drags
         that selected every icon, or into two launches -->
    <property name="DoubleClickDistance" type="int" value="12"/>
    <property name="DoubleClickTime" type="int" value="500"/>
    <property name="DndDragThreshold" type="int" value="16"/>
    <!-- Over VNC, animations and blinking cursors are frames to send -->
    <property name="EnableAnimations" type="bool" value="false"/>
    <property name="CursorBlink" type="bool" value="false"/>
  </property>
</channel>
