{
  "name": "ckpro",
  "version": "0.1.0",
  "private": true,
  "description": "ckpro - Kubernetes exam practice app monorepo",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --filter ckpro-desktop dev",
    "build": "pnpm --filter ckpro-desktop build",
    "typecheck": "pnpm --filter ckpro-desktop typecheck",
    "format": "biome check . --write",
    "format-check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
